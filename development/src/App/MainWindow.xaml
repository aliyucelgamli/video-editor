<Window x:Class="VideoEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1360" Height="840"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!--
      Skeleton shortcuts — these migrate into the customizable shortcut system later.
      Single-key bindings must become focus-context aware once text inputs exist.
    -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
        <KeyBinding Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Key="Subtract" Command="{Binding ZoomOutCommand}"/>
    </Window.InputBindings>

    <Window.Resources>

        <!-- Track header row (left column) -->
        <DataTemplate x:Key="HeaderTemplate">
            <Border Height="48" Margin="0,0,0,2" Background="{StaticResource PanelAltBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" Margin="0,5,0,5"
                            CornerRadius="2" Background="{Binding HeaderBrush}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,7,0">
                        <Button Content="M" Command="{Binding ToggleMuteCommand}" ToolTip="Mute track">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TrackToggle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Background" Value="#FFA63D45"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="S" Command="{Binding ToggleSoloCommand}" ToolTip="Solo track">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TrackToggle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                            <Setter Property="Background" Value="#FF9A7B2D"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="{Binding TypeGlyph}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="9" Foreground="{StaticResource SubtleTextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10"
                                       Foreground="{StaticResource SubtleTextBrush}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Event block on a lane -->
        <DataTemplate x:Key="EventTemplate">
            <Border Height="40" Width="{Binding Width}" CornerRadius="4" Cursor="Hand"
                    Background="{Binding Brush}" ToolTip="{Binding ToolTip}"
                    MouseLeftButtonDown="EventBlock_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="White"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel Margin="6,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}"
                               Foreground="#B0FFFFFF" FontSize="10" VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Track lane (right, scrollable area) -->
        <DataTemplate x:Key="LaneTemplate">
            <Border Height="48" Margin="0,0,0,2" HorizontalAlignment="Left"
                    Background="{StaticResource LaneBrush}"
                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,0,1"
                    Width="{Binding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    AllowDrop="True" DragOver="Lane_DragOver" Drop="Lane_Drop"
                    MouseLeftButtonDown="Lane_MouseLeftButtonDown">
                <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="4"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- ======== Toolbar ======== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <StackPanel Orientation="Horizontal">

                <Border Width="26" Height="26" CornerRadius="7"
                        Background="{StaticResource BrandBrush}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Video Editor" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" Margin="9,0,4,0"/>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding NewProjectCommand}"
                        ToolTip="New Project (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE7C3;"/>
                        <TextBlock Text="New" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}"
                        ToolTip="Open Project (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8E5;"/>
                        <TextBlock Text="Open" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}"
                        ToolTip="Save Project (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74E;"/>
                        <TextBlock Text="Save" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveAsCommand}"
                        ToolTip="Save Project As (Ctrl+Shift+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74E;"/>
                        <TextBlock Text="Save As" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding ImportMediaCommand}"
                        ToolTip="Import media files (or drop them anywhere in the library)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE896;"/>
                        <TextBlock Text="Import" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoToolTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE7A7;"/>
                        <TextBlock Text="Undo" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoToolTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE7A6;"/>
                        <TextBlock Text="Redo" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding AddVideoTrackCommand}"
                        ToolTip="Add video track">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE714;" Foreground="#FF6FA1E8"/>
                        <TextBlock Text="+ Video" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddAudioTrackCommand}"
                        ToolTip="Add audio track">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE767;" Foreground="#FF63BE8B"/>
                        <TextBlock Text="+ Audio" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddOverlayTrackCommand}"
                        ToolTip="Add overlay/text track">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8B9;" Foreground="#FFB08FE0"/>
                        <TextBlock Text="+ Overlay" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ======== Status bar ======== -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding TimelineInfoText}"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                    <TextBlock Text="   |   " Foreground="{StaticResource EdgeBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding HistoryText}"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======== Media Library ======== -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    AllowDrop="True" DragOver="MediaLibrary_DragOver" Drop="MediaLibrary_Drop">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                                Padding="7,4" Margin="0,5,8,0"
                                Command="{Binding ImportMediaCommand}" ToolTip="Import media files">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE710;" FontSize="11"/>
                        </Button>
                        <TextBlock Text="MEDIA LIBRARY" Style="{StaticResource PanelHeader}"/>
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="MediaList"
                                 ItemsSource="{Binding MediaItems}"
                                 ItemContainerStyle="{StaticResource MediaItemContainer}"
                                 Background="Transparent" BorderThickness="0"
                                 AllowDrop="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="MediaList_PreviewMouseMove"
                                 MouseDoubleClick="MediaList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding FilePath}">
                                        <Border DockPanel.Dock="Left" Width="30" Height="30"
                                                CornerRadius="6" Background="#FF23262D">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{Binding GlyphBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetaLabel}" FontSize="10"
                                                       Foreground="{StaticResource SubtleTextBrush}"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MediaItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="#FF3A4050" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop media files here" Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="12" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                            <TextBlock Text="or click Import — then drag clips onto a track"
                                       Foreground="#FF5A616E" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="300" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- ======== Preview ======== -->
                <Border Grid.Row="0" Margin="10" CornerRadius="8" Background="#FF0A0B0D"
                        BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                   Foreground="#FF262B36" HorizontalAlignment="Center"/>
                        <TextBlock Text="No preview yet" Foreground="#FF4A5160" FontSize="13"
                                   Margin="0,12,0,2" HorizontalAlignment="Center"/>
                        <TextBlock Text="The media engine (FFmpeg) arrives in a later step"
                                   Foreground="#FF343B49" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows"/>

                <!-- ======== Timeline ======== -->
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock DockPanel.Dock="Right" Margin="0,10,12,0" FontSize="10"
                                       Foreground="#FF5A616E"
                                       Text="Drag media to a track  •  Wheel: zoom  •  Shift+Wheel: scroll  •  Del: delete"/>
                            <TextBlock Text="TIMELINE" Style="{StaticResource PanelHeader}"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Corner -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,1,1"/>

                            <!-- Ruler -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,0,1">
                                <ScrollViewer x:Name="RulerScroll" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="RulerScroll_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding RulerTicks}" Height="25"
                                                  Width="{Binding TimelineWidth}" HorizontalAlignment="Left">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="10"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               Margin="4,2,0,1"/>
                                                    <Rectangle Width="1" Height="8" HorizontalAlignment="Left"
                                                               Fill="{StaticResource TickBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Track headers -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,1,0">
                                <ScrollViewer x:Name="HeadersScroll" Focusable="False"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="HeadersScroll_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding Tracks}"
                                                  ItemTemplate="{StaticResource HeaderTemplate}"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Lanes -->
                            <ScrollViewer x:Name="LanesScroll" Grid.Row="1" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"
                                          ScrollChanged="LanesScroll_ScrollChanged"
                                          PreviewMouseWheel="LanesScroll_PreviewMouseWheel">
                                <ItemsControl ItemsSource="{Binding Tracks}"
                                              ItemTemplate="{StaticResource LaneTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
