<Window x:Class="VideoEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1360" Height="840"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Keyboard shortcuts are bound at runtime from the ShortcutMap
         (Options > Keyboard Shortcuts…) — see MainWindow.ApplyShortcuts(). -->

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Track header row (left column) -->
        <DataTemplate x:Key="HeaderTemplate">
            <Border Height="56" Margin="0,0,0,2" Background="{StaticResource PanelAltBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" Margin="0,5,0,5"
                            CornerRadius="2" Background="{Binding HeaderBrush}"/>
                    <Grid Margin="9,4,7,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="M" Command="{Binding ToggleMuteCommand}"
                                        ToolTip="{Binding MuteToolTip}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TrackToggle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Background" Value="#FFA63D45"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="S" Command="{Binding ToggleSoloCommand}" ToolTip="Solo track"
                                        Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TrackToggle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSolo}" Value="True">
                                                    <Setter Property="Background" Value="#FF9A7B2D"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding TypeGlyph}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="9" Foreground="{StaticResource SubtleTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10"
                                               Foreground="{StaticResource SubtleTextBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Audio tracks: volume 0-200%. Visual tracks: opacity 0-100%
                             (a volume slider means nothing on a video lane). -->
                        <DockPanel Grid.Row="1" ToolTip="Track volume (0-200%)"
                                   Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="9" Foreground="{StaticResource SubtleTextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeLabel}" FontSize="9"
                                       Width="30" TextAlignment="Right"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                            <Slider Style="{StaticResource FlatSlider}" Margin="5,0,4,0"
                                    Minimum="0" Maximum="200"
                                    Value="{Binding VolumePercent, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="TrackVolume_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="TrackVolume_PreviewMouseUp"
                                    LostMouseCapture="TrackVolume_LostMouseCapture"/>
                        </DockPanel>
                        <DockPanel Grid.Row="1" ToolTip="Track opacity (0-100%) — blends the whole lane over the layers below"
                                   Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="9" Foreground="{StaticResource SubtleTextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityLabel}" FontSize="9"
                                       Width="30" TextAlignment="Right"
                                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                            <Slider Style="{StaticResource FlatSlider}" Margin="5,0,4,0"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding OpacityPercent, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="TrackOpacity_PreviewMouseDown"
                                    PreviewMouseLeftButtonUp="TrackOpacity_PreviewMouseUp"
                                    LostMouseCapture="TrackOpacity_LostMouseCapture"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- Event block on a lane -->
        <DataTemplate x:Key="EventTemplate">
            <Border Height="48" Width="{Binding Width}" CornerRadius="4" Cursor="Hand"
                    Background="{Binding Brush}" ToolTip="{Binding ToolTip}"
                    AllowDrop="True"
                    DragOver="EventBlock_DragOver" Drop="EventBlock_Drop"
                    MouseLeftButtonDown="EventBlock_MouseLeftButtonDown"
                    MouseMove="EventBlock_MouseMove"
                    MouseLeftButtonUp="EventBlock_MouseLeftButtonUp"
                    MouseRightButtonUp="EventBlock_MouseRightButtonUp"
                    LostMouseCapture="EventBlock_LostMouseCapture">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="White"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,10000,48" RadiusX="4" RadiusY="4"/>
                    </Grid.Clip>

                    <!-- Film strip (video/image events) -->
                    <ItemsControl ItemsSource="{Binding Thumbnails}" IsHitTestVisible="False"
                                  Visibility="{Binding HasThumbnails, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Stretch="UniformToFill" Height="48"
                                       RenderOptions.BitmapScalingMode="LowQuality"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Waveform (audio events) -->
                    <Polygon Points="{Binding WaveformPoints}" IsHitTestVisible="False"
                             Fill="#8811381F" Stroke="#CC9CE8BB" StrokeThickness="1"
                             Visibility="{Binding HasWaveform, Converter={StaticResource BoolToVis}}"/>

                    <!-- Fade envelopes: eased curve + shaded faded-away area -->
                    <Canvas IsHitTestVisible="False">
                        <Polygon Points="{Binding FadeInFill}" Fill="#66000000"
                                 Visibility="{Binding HasFadeIn, Converter={StaticResource BoolToVis}}"/>
                        <Polyline Points="{Binding FadeInLine}" Stroke="#D9FFFFFF" StrokeThickness="1.2"
                                  Visibility="{Binding HasFadeIn, Converter={StaticResource BoolToVis}}"/>
                        <Polygon Points="{Binding FadeOutFill}" Fill="#66000000"
                                 Visibility="{Binding HasFadeOut, Converter={StaticResource BoolToVis}}"/>
                        <Polyline Points="{Binding FadeOutLine}" Stroke="#D9FFFFFF" StrokeThickness="1.2"
                                  Visibility="{Binding HasFadeOut, Converter={StaticResource BoolToVis}}"/>
                    </Canvas>

                    <!-- Labels -->
                    <DockPanel Margin="6,2" VerticalAlignment="Top" IsHitTestVisible="False">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DurationLabel}"
                                   Foreground="#B0FFFFFF" FontSize="10" Margin="6,0,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                       Foreground="#B0FFFFFF" Margin="0,1,4,0"
                                       Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}"
                                       ToolTip="Linked audio/video"/>
                            <Border Background="#66000000" CornerRadius="3" Padding="3,0" Margin="0,0,4,0"
                                    Visibility="{Binding HasEffects, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="fx" Foreground="#FFFFD54F" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Bottom-right controls (VEGAS-style): size · fx · properties -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Bottom" Margin="0,0,3,3">
                        <Button Width="20" Height="15" FontSize="9"
                                Content="&#xE740;" FontFamily="Segoe MDL2 Assets"
                                Foreground="#FF9CC3F5"
                                Style="{StaticResource TrackToggle}"
                                Click="EventSize_Click"
                                Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}"
                                ToolTip="Size &amp; position (scale the clip to fit the project resolution)"/>
                        <Button Width="22" Height="15" FontSize="9" FontWeight="Bold"
                                Content="fx" Foreground="#FFFFD54F"
                                Style="{StaticResource TrackToggle}"
                                Click="EventFx_Click"
                                ToolTip="Effects on this clip (add, tweak, remove)"/>
                        <Button Width="20" Height="15" FontSize="9"
                                Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                Foreground="#FFB9C2D0"
                                Style="{StaticResource TrackToggle}"
                                Click="EventMore_Click"
                                ToolTip="Clip properties: speed, volume, fades, info"/>
                    </StackPanel>

                    <!-- Fade grips: hold a top corner and drag inward -->
                    <Path Data="M0,0 L14,0 L0,14 Z" Fill="#7FFFFFFF" Stretch="None"
                          Width="14" Height="14" Tag="in"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Cursor="SizeWE"
                          MouseLeftButtonDown="FadeGrip_MouseDown"
                          MouseMove="FadeGrip_MouseMove"
                          MouseLeftButtonUp="FadeGrip_MouseUp"
                          LostMouseCapture="FadeGrip_LostCapture"
                          ToolTip="Fade in — drag right"/>
                    <Path Data="M14,0 L0,0 L14,14 Z" Fill="#7FFFFFFF" Stretch="None"
                          Width="14" Height="14" Tag="out"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Cursor="SizeWE"
                          MouseLeftButtonDown="FadeGrip_MouseDown"
                          MouseMove="FadeGrip_MouseMove"
                          MouseLeftButtonUp="FadeGrip_MouseUp"
                          LostMouseCapture="FadeGrip_LostCapture"
                          ToolTip="Fade out — drag left"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Track lane (right, scrollable area) -->
        <DataTemplate x:Key="LaneTemplate">
            <Border Height="56" Margin="0,0,0,2" HorizontalAlignment="Left"
                    Background="{StaticResource LaneBrush}"
                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,0,1"
                    Width="{Binding DataContext.TimelineWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    AllowDrop="True" DragOver="Lane_DragOver" Drop="Lane_Drop"
                    MouseLeftButtonDown="Lane_MouseLeftButtonDown"
                    MouseRightButtonUp="Lane_MouseRightButtonUp">
                <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource EventTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="4"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <!-- Effects panel: one available effect -->
        <DataTemplate x:Key="EffectItemTemplate">
            <DockPanel ToolTip="{Binding ToolTip}">
                <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="6"
                        Background="#FF23262D">
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding SourceLabel}" FontSize="9" Margin="6,1,0,0"
                                   Foreground="#FF9A6FD0"/>
                    </StackPanel>
                    <TextBlock FontSize="10" Foreground="{StaticResource SubtleTextBrush}" Margin="0,1,0,0">
                        <Run Text="{Binding Category, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding TargetLabel, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Effects panel: one applied effect with its parameters -->
        <DataTemplate x:Key="AppliedEffectTemplate">
            <Border Background="#FF20242B" CornerRadius="6" Padding="8,6" Margin="8,3">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                FontSize="10" Style="{StaticResource TrackToggle}" Width="20"
                                Command="{Binding RemoveCommand}" ToolTip="Remove effect"/>
                        <CheckBox Style="{StaticResource FlatCheckBox}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Content="{Binding Name}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="10"
                                               Width="72" Foreground="{StaticResource SubtleTextBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueLabel}" FontSize="10"
                                               Width="44" TextAlignment="Right"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <Slider Style="{StaticResource FlatSlider}" Margin="4,0"
                                            Minimum="{Binding Min}" Maximum="{Binding Max}"
                                            Value="{Binding Value, Mode=TwoWay}"
                                            PreviewMouseLeftButtonDown="EffectParam_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="EffectParam_PreviewMouseUp"
                                            LostMouseCapture="EffectParam_LostMouseCapture"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- ======== Menu bar (logo + File/Edit/View/Insert/Tools/Options/Help) ======== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <DockPanel LastChildFill="False">

                <!-- App badge: a slow, easy-on-the-eyes animated gradient -->
                <Border x:Name="LogoBadge" DockPanel.Dock="Left" Width="26" Height="26"
                        CornerRadius="7" VerticalAlignment="Center" ToolTip="Video Editor">
                    <Border.Background>
                        <LinearGradientBrush x:Name="LogoBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop x:Name="LogoStopA" Color="#FF2C5CB4" Offset="0"/>
                            <GradientStop x:Name="LogoStopB" Color="#FF7C4DFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <ColorAnimation Storyboard.TargetName="LogoStopA"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#FF00A896" Duration="0:0:11"/>
                                    <ColorAnimation Storyboard.TargetName="LogoStopB"
                                                    Storyboard.TargetProperty="Color"
                                                    To="#FF2C5CB4" Duration="0:0:11"/>
                                    <PointAnimation Storyboard.TargetName="LogoBrush"
                                                    Storyboard.TargetProperty="EndPoint"
                                                    To="0.2,1" Duration="0:0:13"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center"
                      Margin="8,0,0,0" FontSize="12">
                    <Menu.Resources>
                        <!-- Dropdown popups use the light system theme for now, so
                             submenu items need dark text; top-level headers sit on
                             the dark bar and use the app foreground. -->
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="#FF1B1D22"/>
                            <Style.Triggers>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Padding" Value="9,4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Menu.Resources>

                    <MenuItem Header="_File">
                        <MenuItem Header="_New Project…" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
                        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
                        <Separator/>
                        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
                        <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem Header="_Import Media…" Command="{Binding ImportMediaCommand}"/>
                        <MenuItem Header="_Export…" Command="{Binding ExportCommand}"/>
                        <Separator/>
                        <MenuItem Header="E_xit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
                    </MenuItem>

                    <MenuItem Header="_Edit">
                        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="_Split at Playhead" Command="{Binding SplitAtPlayheadCommand}" InputGestureText="S"/>
                        <MenuItem Header="_Delete Selected" Command="{Binding DeleteSelectedCommand}" InputGestureText="Del"/>
                        <MenuItem Header="Un_link Audio/Video" Command="{Binding UnlinkSelectedCommand}" InputGestureText="T"/>
                        <Separator/>
                        <MenuItem Header="_Clear Export Range" Command="{Binding ClearRangeCommand}" InputGestureText="Ctrl+Shift+R"/>
                    </MenuItem>

                    <MenuItem Header="_View">
                        <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGestureText="+"/>
                        <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGestureText="-"/>
                    </MenuItem>

                    <MenuItem Header="_Insert">
                        <MenuItem Header="_Text…" Command="{Binding AddTextCommand}"/>
                        <MenuItem Header="_Media Files…" Command="{Binding ImportMediaCommand}"/>
                    </MenuItem>

                    <MenuItem Header="_Tools">
                        <MenuItem Header="Download _FFmpeg" Command="{Binding DownloadFfmpegCommand}"/>
                        <MenuItem Header="Open E_xports Folder" Click="MenuOpenExports_Click"/>
                    </MenuItem>

                    <MenuItem Header="_Options">
                        <MenuItem Header="_Settings…" Click="MenuSettings_Click"/>
                        <MenuItem Header="_Keyboard Shortcuts…" Click="MenuShortcuts_Click"/>
                    </MenuItem>

                    <MenuItem Header="_Help">
                        <MenuItem Header="Open _Logs Folder" Click="MenuOpenLogs_Click"/>
                        <Separator/>
                        <MenuItem Header="_About Video Editor" Click="MenuAbout_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ======== Toolbar ======== -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>

                <!-- Export lives top-right (VEGAS-style render button) -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Background="#FF3A3115" VerticalAlignment="Center"
                        Command="{Binding ExportCommand}"
                        ToolTip="Render to MP4 — exports the span between the two yellow bars on the timeline (drag them, or set with I / O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE898;" Foreground="#FFFFD54F"/>
                        <TextBlock Text="Export" Margin="6,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        VerticalAlignment="Center" Margin="0,0,8,0"
                        Command="{Binding AddTextCommand}"
                        ToolTip="Add a title at the playhead (goes to the overlay track)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8D2;"/>
                        <TextBlock Text="Text" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal">

                <Button Style="{StaticResource ToolButton}" Command="{Binding NewProjectCommand}"
                        ToolTip="New Project (Ctrl+N)">
                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE7C3;"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}"
                        ToolTip="Open Project (Ctrl+O)">
                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8E5;"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}"
                        ToolTip="Save Project (Ctrl+S)">
                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE74E;"/>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding ImportMediaCommand}"
                        ToolTip="Import media files (or drop them anywhere in the library)">
                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE896;"/>
                </Button>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoToolTip}">
                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE7A7;"/>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoToolTip}">
                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE7A6;"/>
                </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======== Status bar ======== -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding RangeLabel}" Foreground="#FFFFD54F" FontSize="11"
                               Margin="0,0,12,0"
                               Visibility="{Binding HasExplicitRange, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding TimelineInfoText}"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                    <TextBlock Text="   |   " Foreground="{StaticResource EdgeBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding HistoryText}"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                    <ProgressBar Style="{StaticResource FlatProgressBar}" Width="140" Margin="12,0,0,0"
                                 Minimum="0" Maximum="1" Value="{Binding ExportProgress, Mode=OneWay}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource ToolButton}" Padding="6,2" Margin="8,0,0,0"
                            Content="Cancel" FontSize="10"
                            Command="{Binding CancelExportCommand}"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======== Left panel: Media / Effects tabs ======== -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <TabControl Style="{StaticResource SideTabControl}">

                    <!-- MEDIA tab -->
                    <TabItem Header="MEDIA" Style="{StaticResource SideTabItem}">
                        <Border AllowDrop="True" Background="Transparent"
                                DragOver="MediaLibrary_DragOver" Drop="MediaLibrary_Drop">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                                            Padding="7,4" Margin="0,5,8,0"
                                            Command="{Binding ImportMediaCommand}" ToolTip="Import media files">
                                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE710;" FontSize="11"/>
                                    </Button>
                                    <TextBlock Text="MEDIA LIBRARY" Style="{StaticResource PanelHeader}"/>
                                </DockPanel>
                                <Grid>
                                    <ListBox x:Name="MediaList"
                                             ItemsSource="{Binding MediaItems}"
                                             ItemContainerStyle="{StaticResource MediaItemContainer}"
                                             Background="Transparent" BorderThickness="0"
                                             AllowDrop="True" SelectionMode="Extended"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="MediaList_PreviewMouseMove"
                                             MouseDoubleClick="MediaList_MouseDoubleClick"
                                             PreviewKeyDown="MediaList_PreviewKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel ToolTip="{Binding FilePath}">
                                                    <Border DockPanel.Dock="Left" Width="52" Height="34"
                                                            CornerRadius="5" Background="#FF23262D">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13" Foreground="{Binding GlyphBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border CornerRadius="5"
                                                                    Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Margin="9,0,0,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding MetaLabel}" FontSize="10"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MediaItems.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                   Foreground="#FF3A4050" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Drop media files here" Foreground="{StaticResource SubtleTextBrush}"
                                                   FontSize="12" Margin="0,10,0,2" HorizontalAlignment="Center"/>
                                        <TextBlock Text="or click Import — then drag clips onto a track"
                                                   Foreground="#FF5A616E" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </TabItem>

                    <!-- EFFECTS tab -->
                    <TabItem Header="EFFECTS" Style="{StaticResource SideTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                                            Padding="7,4" Margin="0,5,8,0"
                                            Command="{Binding Effects.ImportVefxCommand}"
                                            ToolTip="Import a .vefx effect file into user/effects">
                                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE710;" FontSize="11"/>
                                    </Button>
                                    <TextBlock Text="EFFECTS" Style="{StaticResource PanelHeader}"/>
                                </DockPanel>
                                <ListBox x:Name="EffectList"
                                         ItemsSource="{Binding Effects.AvailableEffects}"
                                         ItemTemplate="{StaticResource EffectItemTemplate}"
                                         ItemContainerStyle="{StaticResource MediaItemContainer}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="EffectList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="EffectList_PreviewMouseMove"
                                         SelectionChanged="EffectList_SelectionChanged"
                                         MouseDoubleClick="EffectList_MouseDoubleClick"/>
                            </DockPanel>

                            <!-- Selected clip: volume + effect chain -->
                            <Border Grid.Row="1" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,1,0,0"
                                    Background="{StaticResource PanelBrush}"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PanelHeader}" Text="SELECTED CLIP"/>
                                    <TextBlock Text="{Binding SelectedEventName}" Margin="12,0,12,4"
                                               Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>

                                    <DockPanel Margin="12,2,12,6" ToolTip="Clip volume (0–200%, default 100%)"
                                               Visibility="{Binding SelectedHasVolume, Converter={StaticResource BoolToVis}}">
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedVolumeLabel}"
                                                   Width="36" TextAlignment="Right" FontSize="11"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                        <Slider Style="{StaticResource FlatSlider}" Margin="7,0,5,0"
                                                Minimum="0" Maximum="200"
                                                Value="{Binding SelectedVolumePercent, Mode=TwoWay}"
                                                PreviewMouseLeftButtonDown="SelectedVolume_PreviewMouseDown"
                                                PreviewMouseLeftButtonUp="SelectedVolume_PreviewMouseUp"
                                                LostMouseCapture="SelectedVolume_LostMouseCapture"/>
                                    </DockPanel>

                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Effects.AppliedEffects}"
                                                          ItemTemplate="{StaticResource AppliedEffectTemplate}"/>
                                            <TextBlock Text="No effects yet — drag one from the list onto the clip, or double-click an effect."
                                                       FontSize="10" Foreground="#FF5A616E" Margin="12,2,12,8"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Effects.SelectionHasEffects}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border Height="6"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="320" MinHeight="140"/>
                </Grid.RowDefinitions>

                <!-- ======== Preview ======== -->
                <Border Grid.Row="0" Margin="10" CornerRadius="8" Background="#FF0A0B0D"
                        BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Image Grid.Row="0" Source="{Binding Preview.CurrentFrame}" Margin="8"
                               RenderOptions.BitmapScalingMode="LowQuality"/>

                        <!-- Placeholder overlay: hit-testable so the FFmpeg download button works -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.CurrentFrame}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="42"
                                       Foreground="#FF262B36" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click a clip or the timeline to preview a frame"
                                       Foreground="#FF4A5160" FontSize="13"
                                       Margin="0,12,0,2" HorizontalAlignment="Center"/>
                            <TextBlock Text="Space plays with sound, the ruler scrubs"
                                       Foreground="#FF343B49" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="⚠ FFmpeg not found — preview and export are disabled."
                                       Foreground="#FFE0A03C" FontSize="11" Margin="0,14,0,0"
                                       TextAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding FfmpegMissing, Converter={StaticResource BoolToVis}}"/>
                            <Button Margin="0,8,0,0" Padding="14,7" HorizontalAlignment="Center"
                                    Background="#FF2C3E5C"
                                    Style="{StaticResource ToolButton}"
                                    Command="{Binding DownloadFfmpegCommand}"
                                    Visibility="{Binding FfmpegMissing, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Downloads a portable FFmpeg build (~90 MB, one time) into tools\ffmpeg\ — no admin rights needed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE896;"/>
                                    <TextBlock Text="Download FFmpeg automatically" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Downloading FFmpeg… progress is shown in the status bar below."
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,14,0,0"
                                       TextAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding IsInstallingFfmpeg, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <!-- Transport -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,1,0,0"
                                Padding="8,4">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Preview.TimeLabel}"
                                           Foreground="{StaticResource TextBrush}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ToolButton}" Padding="10,4"
                                            Command="{Binding Preview.PlayPauseCommand}" ToolTip="Play / Pause (Space)">
                                        <TextBlock Style="{StaticResource ButtonIcon}" Text="{Binding Preview.PlayPauseGlyph}"/>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Padding="10,4"
                                            Command="{Binding Preview.StopCommand}" ToolTip="Stop (back to start)">
                                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE71A;"/>
                                    </Button>
                                    <Button Padding="10,4" Margin="6,0,0,0"
                                            Command="{Binding Preview.ToggleLoopCommand}"
                                            ToolTip="Loop the selection (drag on an empty lane to select, right-click to clear)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Preview.IsLooping}" Value="True">
                                                        <Setter Property="Background" Value="#FF2C3E5C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="&#xE8EE;" Style="{StaticResource ButtonIcon}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ButtonIcon}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Preview.IsLooping}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF9CC3F5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows"/>

                <!-- ======== Timeline ======== -->
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Corner -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,1,1"/>

                            <!-- Ruler: ticks + yellow range bars + playhead -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,0,1">
                                <ScrollViewer x:Name="RulerScroll" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="RulerScroll_PreviewMouseWheel">
                                    <Grid x:Name="RulerSurface" Height="25" Background="Transparent"
                                          Width="{Binding TimelineWidth}" HorizontalAlignment="Left"
                                          MouseLeftButtonDown="Ruler_MouseLeftButtonDown"
                                          MouseMove="Ruler_MouseMove"
                                          MouseLeftButtonUp="Ruler_MouseLeftButtonUp"
                                          LostMouseCapture="Ruler_LostMouseCapture">

                                        <ItemsControl ItemsSource="{Binding RulerTicks}" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="10"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   Margin="4,2,0,1"/>
                                                        <Rectangle Width="1" Height="8" HorizontalAlignment="Left"
                                                                   Fill="{StaticResource TickBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Yellow export range: start/end bars only (no interior fill) -->
                                        <Border x:Name="RangeStartBar" Width="6" HorizontalAlignment="Left"
                                                Background="#FFFFD54F" CornerRadius="1" Cursor="SizeWE"
                                                ToolTip="Export start — drag to move (I sets it at the playhead)"
                                                Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="{Binding RangeStartX}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border x:Name="RangeEndBar" Width="6" HorizontalAlignment="Left"
                                                Background="#FFFFD54F" CornerRadius="1" Cursor="SizeWE"
                                                ToolTip="Export end — drag to move (O sets it at the playhead)"
                                                RenderTransformOrigin="0,0"
                                                Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <TranslateTransform X="-6"/>
                                                    <TranslateTransform X="{Binding RangeEndX}"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                        </Border>

                                        <!-- Playhead marker -->
                                        <Rectangle Width="2" Height="25" VerticalAlignment="Top"
                                                   HorizontalAlignment="Left" Fill="#FFE5484D"
                                                   IsHitTestVisible="False">
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform X="{Binding PlayheadX}"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!-- Track headers -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,1,0">
                                <ScrollViewer x:Name="HeadersScroll" Focusable="False"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="HeadersScroll_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding Tracks}"
                                                  ItemTemplate="{StaticResource HeaderTemplate}"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Lanes + playhead/range overlay -->
                            <ScrollViewer x:Name="LanesScroll" Grid.Row="1" Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="Transparent"
                                          ScrollChanged="LanesScroll_ScrollChanged"
                                          PreviewMouseWheel="LanesScroll_PreviewMouseWheel">
                                <Grid Width="{Binding TimelineWidth}" HorizontalAlignment="Left">
                                    <ItemsControl ItemsSource="{Binding Tracks}"
                                                  ItemTemplate="{StaticResource LaneTemplate}"/>

                                    <Rectangle Width="1.5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                               Fill="#FFE5484D" IsHitTestVisible="False">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform X="{Binding PlayheadX}"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
