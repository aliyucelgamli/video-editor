<Window x:Class="VideoEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <!--
      Skeleton shortcuts. These migrate into the customizable shortcut system
      (Settings > Keyboard Shortcuts) in a later step. Single-key bindings (Z/Y)
      must become focus-context aware once text input fields exist.
    -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding OpenCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Content="New"
                        Command="{Binding NewProjectCommand}" ToolTip="New Project (Ctrl+N)"/>
                <Button Style="{StaticResource ToolButton}" Content="Open"
                        Command="{Binding OpenCommand}" ToolTip="Open Project (Ctrl+O)"/>
                <Button Style="{StaticResource ToolButton}" Content="Save"
                        Command="{Binding SaveCommand}" ToolTip="Save Project (Ctrl+S)"/>
                <Button Style="{StaticResource ToolButton}" Content="Save As"
                        Command="{Binding SaveAsCommand}" ToolTip="Save Project As (Ctrl+Shift+S)"/>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Content="Import"
                        Command="{Binding ImportMediaCommand}" ToolTip="Import media files"/>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Content="Undo"
                        Command="{Binding UndoCommand}" ToolTip="Undo (Z / Ctrl+Z)"/>
                <Button Style="{StaticResource ToolButton}" Content="Redo"
                        Command="{Binding RedoCommand}" ToolTip="Redo (Y / Ctrl+Y)"/>

                <Border Style="{StaticResource ToolbarSeparator}"/>

                <Button Style="{StaticResource ToolButton}" Content="+ Video"
                        Command="{Binding AddVideoTrackCommand}" ToolTip="Add video track"/>
                <Button Style="{StaticResource ToolButton}" Content="+ Audio"
                        Command="{Binding AddAudioTrackCommand}" ToolTip="Add audio track"/>
                <Button Style="{StaticResource ToolButton}" Content="+ Overlay"
                        Command="{Binding AddOverlayTrackCommand}" ToolTip="Add overlay/text track"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding HistoryText}"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="11"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: Media Library -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MEDIA LIBRARY" Style="{StaticResource PanelHeader}"/>
                    <Grid>
                        <ListBox ItemsSource="{Binding MediaItems}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3" ToolTip="{Binding FilePath}">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No media imported yet.&#10;Use Import to add files."
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MediaItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                          Background="{StaticResource EdgeBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="280" MinHeight="120"/>
                </Grid.RowDefinitions>

                <!-- Video preview -->
                <Border Grid.Row="0" Background="Black" Margin="8">
                    <TextBlock Text="Preview — media engine not connected yet"
                               Foreground="#FF555555"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{StaticResource EdgeBrush}" ResizeDirection="Rows"/>

                <!-- Timeline -->
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="TIMELINE" Style="{StaticResource PanelHeader}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tracks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="44" Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Track header -->
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource PanelAltBrush}"
                                                    BorderBrush="{StaticResource EdgeBrush}"
                                                    BorderThickness="0,0,1,0">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="4"
                                                            Background="{Binding HeaderBrush}"/>
                                                    <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   FontSize="10"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- Track lane -->
                                            <Border Grid.Column="1" Background="{StaticResource LaneBrush}">
                                                <ItemsControl ItemsSource="{Binding Events}" MinWidth="2000">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                            <Setter Property="Canvas.Top" Value="4"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding Width}" Height="36"
                                                                    Background="{Binding Brush}"
                                                                    BorderBrush="#66FFFFFF" BorderThickness="1"
                                                                    CornerRadius="3"
                                                                    ToolTip="{Binding ToolTip}">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="White" FontSize="11"
                                                                           Margin="6,0" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
