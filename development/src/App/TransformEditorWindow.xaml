<Window x:Class="VideoEditor.App.TransformEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Size &amp; Position"
        Width="980" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed">

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="252"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Stage (Unity-style gizmo) ============ -->
        <Border Grid.Column="0" Background="#FF101216" CornerRadius="8" ClipToBounds="True">
            <Canvas x:Name="Stage" Background="Transparent"
                    SizeChanged="Stage_SizeChanged"
                    MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                    MouseMove="Stage_MouseMove"
                    MouseLeftButtonUp="Stage_MouseLeftButtonUp">
                <!-- project frame bounds -->
                <Rectangle x:Name="FrameOutline" Stroke="#FF3A3F4B" StrokeThickness="1"
                           StrokeDashArray="4 3"/>
                <!-- the clip's frame, scaled/moved live -->
                <Image x:Name="LayerImage" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
                <!-- selection border; handles are created in code-behind -->
                <Rectangle x:Name="SelectionRect" Stroke="{StaticResource AccentBrush}"
                           StrokeThickness="1.5" Fill="Transparent"/>
                <!-- Ctrl-snap alignment guides -->
                <Line x:Name="GuideVertical" Stroke="#FFFF8A50" StrokeThickness="1"
                      StrokeDashArray="3 2" Visibility="Collapsed"/>
                <Line x:Name="GuideHorizontal" Stroke="#FFFF8A50" StrokeThickness="1"
                      StrokeDashArray="3 2" Visibility="Collapsed"/>
            </Canvas>
        </Border>

        <!-- ============ Details panel ============ -->
        <DockPanel Grid.Column="1" Margin="14,2,2,2">

            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Background="#FF1F3321" Padding="18,8" Click="Ok_Click">
                    <TextBlock Text="OK" FontWeight="SemiBold" Foreground="#FF9BE28F"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        Padding="14,8" Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click"/>
            </DockPanel>

            <StackPanel>
                <TextBlock Text="SIZE &amp; POSITION" Style="{StaticResource PanelHeader}"/>
                <TextBlock x:Name="ClipNameText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SourceInfoText" FontSize="11" Margin="0,3,0,0"
                           Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Scale X %" FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="ScaleXBox"
                             Style="{StaticResource FlatTextBox}"
                             LostFocus="Field_LostFocus" KeyDown="Field_KeyDown"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Scale Y %" FontSize="11" Margin="0,8,0,0"
                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ScaleYBox" Margin="0,8,0,0"
                             Style="{StaticResource FlatTextBox}"
                             LostFocus="Field_LostFocus" KeyDown="Field_KeyDown"/>

                    <CheckBox Grid.Row="2" Grid.Column="1" x:Name="LockAspectCheck" Margin="0,10,0,0"
                              Style="{StaticResource FlatCheckBox}"
                              Content="Lock aspect ratio"
                              Checked="LockAspect_Changed" Unchecked="LockAspect_Changed"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Position X" FontSize="11" Margin="0,12,0,0"
                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="PositionXBox" Margin="0,12,0,0"
                             Style="{StaticResource FlatTextBox}"
                             LostFocus="Field_LostFocus" KeyDown="Field_KeyDown"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Position Y" FontSize="11" Margin="0,8,0,0"
                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="PositionYBox" Margin="0,8,0,0"
                             Style="{StaticResource FlatTextBox}"
                             LostFocus="Field_LostFocus" KeyDown="Field_KeyDown"/>
                </Grid>

                <Button Style="{StaticResource ToolButton}" Padding="12,6" Margin="0,14,0,0"
                        HorizontalAlignment="Left" Click="Reset_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE777;"/>
                        <TextBlock Text="Reset" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <TextBlock FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SubtleTextBrush}"
                           Text="Drag the corners to scale (aspect stays locked), the edges to stretch one axis, and inside the frame to move. Hold Ctrl while moving to snap to the frame's edges, corners and center lines. Esc cancels a drag."/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
