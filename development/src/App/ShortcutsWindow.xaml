<Window x:Class="VideoEditor.App.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts"
        Width="460" Height="620" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <DockPanel Margin="14,12">

        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Padding="12,7"
                    Content="Reset All to Defaults" Click="ResetAll_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="18,7"
                    Content="Close" Click="Close_Click"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                   Foreground="{StaticResource SubtleTextBrush}"
                   Text="Click a shortcut, then press the keys you want (for example Ctrl+Z). Esc cancels. Assigning a key that is already in use moves it to the new action."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,6,12">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource PanelHeader}"
                                       Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" MinWidth="150"
                                                    Style="{StaticResource ToolButton}" Padding="10,4"
                                                    HorizontalContentAlignment="Center"
                                                    Click="Gesture_Click">
                                                <TextBlock FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding GestureText}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                                    <Setter Property="Text" Value="Press keys…"/>
                                                                    <Setter Property="Foreground" Value="#FFFFD54F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
