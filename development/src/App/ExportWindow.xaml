<Window x:Class="VideoEditor.App.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="14,12">

        <TextBlock Text="FORMAT" Style="{StaticResource PanelHeader}" Margin="0,0,0,6"/>
        <ListBox x:Name="FormatList"
                 Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource MediaItemContainer}"
                 SelectionChanged="FormatList_SelectionChanged"/>

        <TextBlock Text="SETTINGS" Style="{StaticResource PanelHeader}" Margin="0,12,0,6"/>
        <Grid x:Name="VideoSettings">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="WidthBox" Style="{StaticResource FlatTextBox}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="×" HorizontalAlignment="Center"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="HeightBox" Style="{StaticResource FlatTextBox}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Frame rate" FontSize="11" Margin="0,8,0,0"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FpsBox" Style="{StaticResource FlatTextBox}"
                     Margin="0,8,0,0"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Quality" FontSize="11" Margin="0,10,0,0"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"
                       ToolTip="Higher = better quality, larger file"/>
            <Slider Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="QualitySlider"
                    Style="{StaticResource FlatSlider}" Margin="0,10,0,0"
                    Minimum="0" Maximum="100" Value="70"/>
        </Grid>

        <StackPanel x:Name="GpuPanel" Margin="0,10,0,0">
            <CheckBox x:Name="GpuCheck" Style="{StaticResource FlatCheckBox}" IsChecked="True"
                      Content="Hardware encoder (GPU)"
                      ToolTip="Uses the graphics card to encode (NVENC / Quick Sync / AMF) — several times faster. Falls back to the CPU encoder when no GPU encoder works."/>
            <TextBlock x:Name="GpuInfo" FontSize="11" Margin="22,3,0,0"
                       Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock x:Name="RangeInfo" FontSize="11" Margin="0,12,0,0"
                   Foreground="#FFFFD54F" TextWrapping="Wrap"/>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Background="#FF3A3115"
                    Padding="16,8" Click="Export_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE898;" Foreground="#FFFFD54F"/>
                    <TextBlock Text="Export…" Margin="7,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="14,8"
                    Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
