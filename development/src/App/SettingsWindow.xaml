<Window x:Class="VideoEditor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="14,12">

        <TextBlock Text="EXPORT" Style="{StaticResource PanelHeader}"/>

        <TextBlock Text="Default export folder" FontSize="11" Margin="0,8,0,3"
                   Foreground="{StaticResource SubtleTextBrush}"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="10,5"
                    Margin="6,0,0,0" Content="Browse…" Click="Browse_Click"/>
            <TextBox x:Name="ExportFolderBox" Style="{StaticResource FlatTextBox}"
                     ToolTip="Leave empty to use user\exports next to the app"/>
        </DockPanel>

        <CheckBox x:Name="GpuDefaultCheck" Style="{StaticResource FlatCheckBox}" Margin="0,12,0,0"
                  Content="Prefer the hardware (GPU) encoder by default"
                  ToolTip="Initial state of the export dialog's checkbox — each export can still change it"/>

        <TextBlock Text="GENERAL" Style="{StaticResource PanelHeader}" Margin="0,16,0,0"/>
        <CheckBox x:Name="ConfirmExitCheck" Style="{StaticResource FlatCheckBox}" Margin="0,8,0,0"
                  Content="Warn about unsaved changes when closing the app"
                  ToolTip="Off by default. New Project and Open always ask, whatever this is set to."/>

        <TextBlock Text="PLAYBACK" Style="{StaticResource PanelHeader}" Margin="0,16,0,0"/>
        <TextBlock Text="Preview quality" FontSize="11" Margin="0,8,0,3"
                   Foreground="{StaticResource SubtleTextBrush}"/>
        <ComboBox x:Name="PreviewQualityBox"
                  ToolTip="Only affects the preview monitor — export always renders at full project resolution"/>
        <TextBlock x:Name="PreviewQualityHint" FontSize="10" Margin="0,4,0,0"
                   TextWrapping="Wrap" Foreground="#FF5A616E"/>

        <CheckBox x:Name="GpuDecodeCheck" Style="{StaticResource FlatCheckBox}" Margin="0,12,0,0"
                  Content="Decode preview frames on the GPU (experimental)"
                  ToolTip="Only affects seeking to a new frame. Run the performance test below to see whether it is faster on this machine."/>

        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource PanelHeader}" Margin="0,16,0,0"/>
        <TextBlock Text="Measures where playback time goes on this machine and writes a report you can share."
                   FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="#FF5A616E"/>
        <DockPanel Margin="0,8,0,0">
            <Button x:Name="PerfTestButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}"
                    Padding="12,6" Click="RunPerformanceTest_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE9D9;"/>
                    <TextBlock Text="Run performance test" Margin="6,0,0,0"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="PerfStatus" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontSize="10" TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource SubtleTextBrush}"/>
        </DockPanel>

        <TextBlock Text="KEYBOARD" Style="{StaticResource PanelHeader}" Margin="0,16,0,0"/>
        <Button Style="{StaticResource ToolButton}" Padding="12,6" Margin="0,8,0,0"
                HorizontalAlignment="Left" Click="OpenShortcuts_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE765;"/>
                <TextBlock Text="Keyboard Shortcuts…" Margin="6,0,0,0"/>
            </StackPanel>
        </Button>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                    Background="#FF1F3321" Padding="18,8" Click="Ok_Click">
                <TextBlock Text="OK" FontWeight="SemiBold" Foreground="#FF9BE28F"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="14,8"
                    Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
