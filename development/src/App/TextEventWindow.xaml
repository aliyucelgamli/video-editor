<Window x:Class="VideoEditor.App.TextEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="14,12">

        <TextBlock Text="TEXT" Style="{StaticResource PanelHeader}"/>
        <TextBox x:Name="ContentBox" Style="{StaticResource FlatTextBox}" Margin="0,6,0,0"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="120"
                 VerticalScrollBarVisibility="Auto"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Font" FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FontBox" IsEditable="True"
                      VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="Size px" FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Margin="0,0,6,0"/>
            <TextBox Grid.Row="0" Grid.Column="4" x:Name="SizeBox" Style="{StaticResource FlatTextBox}"/>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="BoldCheck" Style="{StaticResource FlatCheckBox}" Content="Bold"/>
                <CheckBox x:Name="ItalicCheck" Style="{StaticResource FlatCheckBox}" Content="Italic"
                          Margin="14,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Color" FontSize="11" Margin="0,12,0,0"
                       Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal"
                        Margin="0,12,0,0">
                <TextBox x:Name="ColorBox" Style="{StaticResource FlatTextBox}" Width="88"
                         ToolTip="Hex color, e.g. #FFFFFFFF"/>
                <TextBlock Text="Outline" FontSize="11" Margin="14,0,6,0"
                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                <TextBox x:Name="OutlineColorBox" Style="{StaticResource FlatTextBox}" Width="88"
                         ToolTip="Outline hex color"/>
                <TextBox x:Name="OutlineWidthBox" Style="{StaticResource FlatTextBox}" Width="44"
                         Margin="6,0,0,0" ToolTip="Outline thickness in project pixels (0 = none)"/>
            </StackPanel>
        </Grid>

        <TextBlock FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource SubtleTextBrush}"
                   Text="The title is placed at the playhead on the overlay track. Move and scale it with the clip's size button (gizmo editor)."/>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                    Background="#FF1F3321" Padding="18,8" Click="Ok_Click">
                <TextBlock Text="OK" FontWeight="SemiBold" Foreground="#FF9BE28F"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="14,8"
                    Margin="0,0,8,0" Content="Cancel" Click="Cancel_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
