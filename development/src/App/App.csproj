<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows compiling this WPF project on non-Windows build agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>VideoEditor</AssemblyName>
    <RootNamespace>VideoEditor.App</RootNamespace>
    <!-- Explorer / taskbar icon of the built exe. -->
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Branding. Replace these two files and rebuild to change the app's look;
       appicon.png is what the title bar badge shows, appicon.ico the window
       and executable icon. -->
  <ItemGroup>
    <Resource Include="Assets\appicon.png" />
    <Resource Include="Assets\appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Application\Application.csproj" />
    <ProjectReference Include="..\ProjectIO\ProjectIO.csproj" />
    <ProjectReference Include="..\MediaEngine\MediaEngine.csproj" />
  </ItemGroup>

</Project>
