<Window x:Class="VideoEditor.App.EventFxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event FX"
        Width="440" Height="560"
        MinWidth="360" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Clip name -->
        <TextBlock Grid.Row="0" x:Name="ClipNameText" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>

        <TextBlock Grid.Row="1" Text="AVAILABLE EFFECTS — double-click or select and Add"
                   Style="{StaticResource PanelHeader}" Margin="0,10,0,6"/>

        <!-- Compatible effects to add -->
        <Border Grid.Row="2" Background="{StaticResource PanelAltBrush}" CornerRadius="6">
            <DockPanel Margin="4">
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}"
                        VerticalAlignment="Top" Margin="6,4,4,0" Padding="10,6"
                        Background="#FF2C3E5C" Click="Add_Click"
                        ToolTip="Add the selected effect to this clip">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE710;" FontSize="11"/>
                        <TextBlock Text="Add" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <ListBox x:Name="EffectPicker"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource MediaItemContainer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="EffectPicker_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel ToolTip="{Binding ToolTip}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontSize="10"
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="APPLIED EFFECTS — tweak, toggle or remove"
                   Style="{StaticResource PanelHeader}" Margin="0,12,0,6"/>

        <!-- Applied chain with editable parameters -->
        <Border Grid.Row="4" Background="{StaticResource PanelAltBrush}" CornerRadius="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                    <ItemsControl ItemsSource="{Binding Effects.AppliedEffects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF20242B" CornerRadius="6" Padding="10,8" Margin="8,4">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="&#xE74D;"
                                                    FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                    Style="{StaticResource TrackToggle}" Width="22"
                                                    Command="{Binding RemoveCommand}" ToolTip="Remove this effect"/>
                                            <CheckBox Style="{StaticResource FlatCheckBox}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Content="{Binding Name}" FontWeight="SemiBold"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,3,0,0">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}"
                                                                   FontSize="11" Width="86"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ValueLabel}"
                                                                   FontSize="11" Width="52" TextAlignment="Right"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Slider Style="{StaticResource FlatSlider}" Margin="4,0"
                                                                Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                                Value="{Binding Value, Mode=TwoWay}"
                                                                PreviewMouseLeftButtonDown="Param_PreviewMouseDown"
                                                                PreviewMouseLeftButtonUp="Param_PreviewMouseUp"
                                                                LostMouseCapture="Param_LostMouseCapture"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="No effects on this clip yet.&#10;Double-click an effect above to add it."
                           Foreground="#FF5A616E" FontSize="11" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Effects.SelectionHasEffects}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
