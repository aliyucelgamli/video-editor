<Window x:Class="VideoEditor.App.EventPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip Properties"
        Width="440" Height="620"
        MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="86"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="76"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- One half of the window: a titled card -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FF20242C"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
        <StackPanel>

            <!-- Identity -->
            <TextBlock Text="{Binding ClipName}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding InfoLabel}" FontSize="10" Margin="0,4,0,0"
                       Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding FileLabel}" FontSize="10" Margin="0,2,0,12"
                       Foreground="#FF5A616E" TextWrapping="Wrap"/>

            <!-- ============ 1) Shared by every clip ============ -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="COMMON" Style="{StaticResource PanelHeader}" Margin="0,0,0,6"/>

                    <DockPanel Margin="0,3,0,0"
                               ToolTip="Higher layers render on top (View > Layers… shows the whole stack)"
                               Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Layer" Style="{StaticResource RowLabel}"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="&#xE96E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                    Style="{StaticResource TrackToggle}" Width="22" Height="18"
                                    Command="{Binding LowerLayerCommand}" ToolTip="Send backward"/>
                            <Button Content="&#xE96D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                    Style="{StaticResource TrackToggle}" Width="22" Height="18"
                                    Command="{Binding RaiseLayerCommand}" ToolTip="Bring forward"/>
                            <TextBlock Text="{Binding LayerLabel}" Width="34" TextAlignment="Right"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <TextBlock/>
                    </DockPanel>

                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="Fade in" Style="{StaticResource RowLabel}"/>
                        <TextBlock Text="{Binding FadeInLabel}" Style="{StaticResource RowValue}" DockPanel.Dock="Right"/>
                        <Slider Style="{StaticResource FlatSlider}" Margin="4,0" Tag="fadein"
                                Minimum="0" Maximum="5" Value="{Binding FadeInSeconds, Mode=TwoWay}"
                                PreviewMouseLeftButtonDown="Slider_BeginEdit"
                                PreviewMouseLeftButtonUp="Slider_EndEdit"
                                LostMouseCapture="Slider_EndEdit"/>
                    </DockPanel>
                    <DockPanel Margin="0,3,0,0">
                        <TextBlock Text="Fade out" Style="{StaticResource RowLabel}"/>
                        <TextBlock Text="{Binding FadeOutLabel}" Style="{StaticResource RowValue}" DockPanel.Dock="Right"/>
                        <Slider Style="{StaticResource FlatSlider}" Margin="4,0" Tag="fadeout"
                                Minimum="0" Maximum="5" Value="{Binding FadeOutSeconds, Mode=TwoWay}"
                                PreviewMouseLeftButtonDown="Slider_BeginEdit"
                                PreviewMouseLeftButtonUp="Slider_EndEdit"
                                LostMouseCapture="Slider_EndEdit"/>
                    </DockPanel>

                    <DockPanel Margin="0,3,0,0"
                               ToolTip="Stretches the clip on the timeline; the source file is untouched"
                               Visibility="{Binding HasPlaybackSpeed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Speed" Style="{StaticResource RowLabel}"/>
                        <TextBlock Text="{Binding SpeedLabel}" Style="{StaticResource RowValue}" DockPanel.Dock="Right"/>
                        <Slider Style="{StaticResource FlatSlider}" Margin="4,0" Tag="speed"
                                Minimum="25" Maximum="400" Value="{Binding SpeedPercent, Mode=TwoWay}"
                                PreviewMouseLeftButtonDown="Slider_BeginEdit"
                                PreviewMouseLeftButtonUp="Slider_EndEdit"
                                LostMouseCapture="Slider_EndEdit"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ============ 2) Only for this kind of clip ============ -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Reset" FontSize="10" Padding="8,3"
                                Style="{StaticResource ToolButton}"
                                Command="{Binding ResetTransformCommand}"
                                Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}"
                                ToolTip="Back to 100% scale, centered"/>
                        <TextBlock Text="{Binding TypeTitle}" Style="{StaticResource PanelHeader}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Visual clips: size, position, opacity -->
                    <StackPanel Visibility="{Binding IsVisual, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock Text="Scale" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding ScaleLabel}" Style="{StaticResource RowValue}" DockPanel.Dock="Right"/>
                            <Slider Style="{StaticResource FlatSlider}" Margin="4,0" Tag="scale"
                                    Minimum="10" Maximum="400" Value="{Binding ScalePercent, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="Slider_BeginEdit"
                                    PreviewMouseLeftButtonUp="Slider_EndEdit"
                                    LostMouseCapture="Slider_EndEdit"/>
                        </DockPanel>
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock Text="Position X" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding PositionXLabel}" Style="{StaticResource RowValue}" DockPanel.Dock="Right"/>
                            <Slider Style="{StaticResource FlatSlider}" Margin="4,0" Tag="posx"
                                    Minimum="{Binding MaxPositionXNegative}" Maximum="{Binding MaxPositionX}"
                                    Value="{Binding PositionX, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="Slider_BeginEdit"
                                    PreviewMouseLeftButtonUp="Slider_EndEdit"
                                    LostMouseCapture="Slider_EndEdit"/>
                        </DockPanel>
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock Text="Position Y" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding PositionYLabel}" Style="{StaticResource RowValue}" DockPanel.Dock="Right"/>
                            <Slider Style="{StaticResource FlatSlider}" Margin="4,0" Tag="posy"
                                    Minimum="{Binding MaxPositionYNegative}" Maximum="{Binding MaxPositionY}"
                                    Value="{Binding PositionY, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="Slider_BeginEdit"
                                    PreviewMouseLeftButtonUp="Slider_EndEdit"
                                    LostMouseCapture="Slider_EndEdit"/>
                        </DockPanel>
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock Text="Opacity" Style="{StaticResource RowLabel}"/>
                            <TextBlock Text="{Binding OpacityLabel}" Style="{StaticResource RowValue}" DockPanel.Dock="Right"/>
                            <Slider Style="{StaticResource FlatSlider}" Margin="4,0" Tag="opacity"
                                    Minimum="0" Maximum="100" Value="{Binding OpacityPercent, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="Slider_BeginEdit"
                                    PreviewMouseLeftButtonUp="Slider_EndEdit"
                                    LostMouseCapture="Slider_EndEdit"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Anything with audio: level -->
                    <DockPanel Margin="0,3,0,0"
                               Visibility="{Binding HasVolume, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Volume" Style="{StaticResource RowLabel}"/>
                        <TextBlock Text="{Binding VolumeLabel}" Style="{StaticResource RowValue}" DockPanel.Dock="Right"/>
                        <Slider Style="{StaticResource FlatSlider}" Margin="4,0" Tag="volume"
                                Minimum="0" Maximum="200" Value="{Binding VolumePercent, Mode=TwoWay}"
                                PreviewMouseLeftButtonDown="Slider_BeginEdit"
                                PreviewMouseLeftButtonUp="Slider_EndEdit"
                                LostMouseCapture="Slider_EndEdit"/>
                    </DockPanel>

                    <!-- Titles: jump straight to the text editor -->
                    <Button Style="{StaticResource ToolButton}" Padding="12,6" Margin="0,6,0,0"
                            HorizontalAlignment="Left" Click="EditText_Click"
                            Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ButtonIcon}" Text="&#xE8D2;"/>
                            <TextBlock Text="Edit text…" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
