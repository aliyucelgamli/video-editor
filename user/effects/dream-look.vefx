{
  "formatVersion": 1,
  "effect": {
    "id": "dream-look",
    "name": "Dream Look",
    "category": "Custom",
    "description": "Soft, warm, dreamy footage — a composite of blur, warmth and brightness.",
    "targets": "visual",
    "parameters": [
      { "key": "softness", "label": "Softness", "min": 0, "max": 10, "default": 3, "unit": "px" },
      { "key": "warmth", "label": "Warmth", "min": -1, "max": 1, "default": 0.35 }
    ],
    "steps": [
      { "kernel": "blur", "args": { "radius": "$softness" } },
      { "kernel": "temperature", "args": { "amount": "$warmth" } },
      { "kernel": "brightness", "args": { "amount": "0.08" } }
    ]
  }
}
